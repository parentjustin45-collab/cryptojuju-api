{
  "name": "cryptojuju-api",
  "version": "1.0.0",
  "description": "Backend API for CryptoJuju Charts",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "prepare:research": "bash scripts/prepare-research.sh",
    "start:agents-staging": "node server-render-ai.mjs",
    "test:agents-staging": "node --test vendor/cryptojuju-charts/backtest/agents/render-plan.test.mjs vendor/cryptojuju-charts/backtest/agents/render-runtime.test.mjs vendor/cryptojuju-charts/backtest/agents/render-api.test.mjs vendor/cryptojuju-charts/backtest/agents/render-knowledge.test.mjs vendor/cryptojuju-charts/backtest/agents/render-db-readiness.test.mjs",
    "check:db-staging": "node vendor/cryptojuju-charts/backtest/agents/render/db-readiness.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "pg": "^8.16.3"
  }
}
